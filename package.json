{
  "name": "dsh-trace-collapse",
  "version": "0.1.0",
  "description": "DeepSeek Harness web GUI: collapse the agent trace (tool calls, thinking, workflow steps) while always keeping the agent's final output. A setting controls whether the trace is default-collapsed after the final output completes (default on).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "trace",
    "collapse",
    "deepseek-harness"
  ],
  "license": "MIT"
}
